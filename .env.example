# Copy file nay thanh .env, sau do dien key/model that cua ban.
# Khong commit/chia se file .env vi no chua API key.

# OpenRouter / NVIDIA model
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/ten-model-tren-openrouter
LLM_API_STYLE=responses
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=8000
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=2

# Gemini: provider phu, chi dung cho case dev 1-56 khi chay
# python -m research.experiments.stage2b_eval --provider gemini ...
# Ban mien phi dung prompt de huan luyen; khong gui case 58-100.
# GEMINI_API_KEY=your-ai-studio-key
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_REASONING_EFFORT=minimal

# Neu dung OpenAI truc tiep thi co the dung:
# OPENAI_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4.1-mini
# LLM_API_STYLE=responses
